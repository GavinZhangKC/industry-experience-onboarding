# Copy to .env and fill in. .env must never be committed.

# mock = synthetic routes, no key needed, no billing. Use this until the key exists.
# google = live Google Routes API calls.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Comma separated. Add the deployed frontend origin before release.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# AC criterion: at least 3 refuges within an 800 m walking radius.
DEFAULT_RADIUS_METRES=800

PROXIMITY_METRES=120
LOW_THRESHOLD=33
MEDIUM_THRESHOLD=66

LOG_LEVEL=INFO

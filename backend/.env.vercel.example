# Add these in the Vercel backend project's Environment Variables page.
# Never put real credentials in this file.

# Demo deployment: use the checked-in seed data until Aurora is available.
DATA_BACKEND=json

# Keep these ready for the later switch to DATA_BACKEND=aurora.
AURORA_AWS_REGION=ap-southeast-2
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=postgres

# MVP credential option. Use a dedicated least-privilege IAM identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Replace this with the production frontend URL, without a trailing slash.
ALLOWED_ORIGINS=https://your-frontend-project.vercel.app

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
